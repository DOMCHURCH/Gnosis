{
  "name": "dom-agent",
  "version": "0.1.0",
  "description": "dom — a terminal coding agent. OpenRouter-only, runtime model switching, Windows-first.",
  "type": "module",
  "bin": {
    "dom": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && vite build --config web/vite.config.ts",
    "build:server": "tsc",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "verify": "node verify/run-all.mjs",
    "eval": "node eval/run-eval.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "execa": "^9.5.1",
    "highlight.js": "^11.12.0",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tree-sitter-wasms": "^0.1.11",
    "web-tree-sitter": "^0.20.8",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
